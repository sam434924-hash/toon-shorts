{
  "name": "pixel_art",
  "renderer": "gemini",
  "image_prompt_prefix": "16-bit retro arcade pixel art, vibrant limited color palette, crisp pixel grid, expressive pixelated characters, nostalgic vintage side-scrolling video game aesthetic, clean sprites",

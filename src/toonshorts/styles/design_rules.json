{
  "version": 2,
  "name": "toonshorts_whiteboard_design_system",
  "safe_zone": {
    "viewport_width": 1080,
    "viewport_height": 1920,
    "top_cutoff_px": 230,
    "bottom_cutoff_px": 1535,
    "margin_x_min_px": 60,
    "max_empty_strip_px": 120
  },
  "typography": {
    "modular_scale": {
      "ratio": 1.333,
      "base_px": 48,
      "scale": {
        "smallest": 48,
        "card_title": 64,
        "scene_title": 85,
        "hero": 114
      }
    },
    "min_board_font_px": 48,
    "caption": {
      "font_size_min_px": 60,
      "font_size_max_px": 75,
      "font_size_target_px": 68,
      "max_lines": 2,
      "no_ellipsis": true
    },
    "fonts": [
      "Arial",
      "-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif"
    ]
  },
  "spacing_and_shape": {
    "grid_step_px": 24,
    "card_corner_radius_px": 24,
    "card_stroke_width_px": 4,
    "uniform_card_height": true
  },
  "board_fill": {
    "top_min_px": 200,
    "top_max_px": 260,
    "top_target_px": 230,
    "content_start_max_offset_px": 48,
    "content_coverage_min": 0.50,
    "content_coverage_max": 0.78,
    "hero_element_coverage_min": 0.40,
    "board_height_safe_area_ratio_min": 0.45,
    "min_whitespace_ratio": 0.20
  },
  "character_proportions": {
    "height_ratio_to_board_min": 0.55,
    "height_ratio_to_board_max": 0.70,
    "shared_floor_line": true,
    "feet_max_y_px": 1535,
    "caption_overlap_allowed": false,
    "caption_beside_character": true
  },
  "layout_rules": {
    "max_card_columns": 1,
    "max_words_per_line": 6,
    "max_cards_per_scene": 3,
    "no_long_all_caps": true
  },
  "color": {
    "dominant": {
      "name": "whiteboard_canvas",
      "hex": "#F7F4FF",
      "target_share": 0.60,
      "role": "Whiteboard drawing surface and primary canvas background"
    },
    "secondary": {
      "deep": {
        "name": "deep_purple",
        "hex": "#3D1F7A",
        "role": "Room wall, board outer frame, title bars, card headers and primary outlines"
      },
      "mid": {
        "name": "mid_purple",
        "hex": "#6D3FD0",
        "role": "Supporting shapes, arrows, accents and secondary containers"
      },
      "text": {
        "name": "dark_purple_text",
        "hex": "#1B1240",
        "role": "High-contrast text on whiteboard and cards (minimum 4.5:1 WCAG)"
      },
      "target_share": 0.30
    },
    "accent": {
      "name": "warm_amber",
      "hex": "#FFB800",
      "target_share": 0.10,
      "min_share": 0.05,
      "max_share": 0.15,
      "max_card_fill_share": 0.10,
      "role": "Single key focal element highlight, outline, or underline only (never full card fill)"
    },
    "meaning": {
      "done_safe": {
        "name": "teal",
        "hex": "#17B8A6",
        "role": "Verified, done, safe, approval state"
      },
      "danger_blocked": {
        "name": "red",
        "hex": "#E5484D",
        "role": "Danger, blocked, warning, error loop (used only in danger scenes)"
      },
      "agent_ai": {
        "name": "purple",
        "hex": "#6D3FD0",
        "role": "Autonomous agent, AI workflow, execution"
      },
      "key_item": {
        "name": "amber",
        "hex": "#FFB800",
        "role": "Primary focal element or key deliverable"
      }
    },
    "rules": {
      "max_hues_per_board": 3,
      "color_by_meaning_only": true,
      "min_text_contrast": 4.5
    }
  }
}

{
  "name": "chalkboard",
  "renderer": "gemini",
  "image_prompt_prefix": "Detailed dusty chalk drawing on a dark textured slate blackboard, white and pastel colored chalk dust smudges, expressive chalk crosshatching, charming classroom blackboard illustration",
  "color_palette": {
    "background": "#1C2321",
    "primary": "#FFFFFF",
    "secondary": "#70D6FF",
    "accent": "#FFD166"
  },
  "caption": {
    "font": "Arial",
    "font_size": 72,
    "primary_color": "&H00FFFFFF",
    "outline_color": "&H00000000",
    "highlight_color": "&H001C9FFF",
    "style": "chalk_glow"
  },
  "pacing": "moderate",
  "default_sound_effects": ["chalk_tap", "bell", "pop"],
  "avoid": [
    "photorealistic human skin",
    "glossy plastic surfaces",
    "modern 3D animation",
    "neon bloom",
    "lens flare",
    "clean vector gradients"
  ]
}

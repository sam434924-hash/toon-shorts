{
  "name": "paper_cutout",
  "renderer": "gemini",
  "image_prompt_prefix": "Layered papercraft stop-motion cutout art, tactile textured cardstock collage, subtle natural drop shadows between paper layers, clean sharp scissor cut silhouette edges, vibrant hand-crafted aesthetic",
  "color_palette": {
    "background": "#F4EBD9",
    "primary": "#E07A5F",
    "secondary": "#3D405B",
    "accent": "#81B29A"
  },
  "caption": {
    "font": "Arial",
    "font_size": 72,
    "primary_color": "&H00FFFFFF",
    "outline_color": "&H001F2421",
    "highlight_color": "&H008FF2CC",
    "style": "drop_shadow"
  },
  "pacing": "moderate",
  "default_sound_effects": ["snip", "card_flip", "thud"],
  "avoid": [
    "glossy 3D animation",
    "blurry gradients",
    "digital airbrush strokes",
    "watercolors",
    "photorealistic faces",
    "lens flare"
  ]
}
